{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "lib": [
      "ESNext",
      "DOM"
    ],

    "types": [
      "@dcloudio/types"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}